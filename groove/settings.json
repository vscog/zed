{
  "theme": {
    "mode": "dark",
    "dark": "Groove Ink Black",
    "light": "One Light"
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true
  },
  "ui_font_family": "Inter",
  "ui_font_size": 16,
  "buffer_font_family": "GeistMono Nerd Font Mono",
  "buffer_font_size": 14,
  "buffer_line_height": "comfortable",
  "relative_line_numbers": "enabled",
  "window_decorations": "server",
  "title_bar": {
    "show_branch_name": true,
    "show_branch_status_icon": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false
  },
  "project_panel": {
    "dock": "left",
    "default_width": 300,
    "auto_reveal_entries": true,
    "starts_open": true,
    "file_icons": true,
    "folder_indicator": "both",
    "entry_spacing": "standard",
    "indent_size": 16,
    "auto_fold_dirs": false,
    "git_status": true,
    "indent_guides": {
      "show": "always"
    }
  },
  "git_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 300,
    "file_icons": true,
    "folder_indicator": "both"
  },
  "terminal": {
    "dock": "bottom",
    "default_height": 260,
    "font_family": "GeistMono Nerd Font Mono",
    "font_size": 14,
    "working_directory": "current_project_directory"
  },
  "indent_guides": {
    "enabled": true
  },
  "inlay_hints": {
    "enabled": false
  },
  "sticky_scroll": {
    "enabled": true
  },
  "use_smartcase_search": true,
  "format_on_save": "on",
  "which_key": {
    "enabled": true
  },
  "auto_update": false,
  "agent_ui_font_size": 14,
  "agent_buffer_font_size": 14,
  "agent": {
    "enabled": true,
    "button": true,
    "dock": "right",
    "default_width": 640,
    "flexible": false
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
      "env": {
        "CODEX_HOME": "/home/valentin/.codex"
      }
    },
    "claude-acp": {
      "type": "registry",
      "env": {
        "CLAUDE_CONFIG_DIR": "/home/valentin/.claude"
      }
    }
  },
  "auto_install_extensions": {
    "html": true,
    "toml": true,
    "dockerfile": true,
    "docker-compose": true,
    "lua": true,
    "nix": true,
    "glsl": true,
    "wgsl": true
  }
}
